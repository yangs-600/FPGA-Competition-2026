[options]
mode prove
depth 5
expect pass,fail,unknown,timeout

timeout 60

[engines]
abc pdr

[script]
verilog_defaults -add -D CHECK_OUTPUTS
read_verilog -sv ../../../../../partitions/test3.sr_out.sv
read_rtlil ../../../../../partitions/test3.sr_out.il
hierarchy -top miter; proc

async2sync
formalff -clk2ff -ff2anyinit gate.test3.sr_out
setundef -anyseq gate.test3.sr_out
flatten -wb; dffunmap; opt_expr -keepdc -undriven; opt_clean
xprop -formal -split-ports -assume-def-inputs miter

