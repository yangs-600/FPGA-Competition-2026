# running in test1.por6_out/src/
verilog_defaults -add -D CHECK_OUTPUTS
read_verilog -sv ../../../../../partitions/test1.por6_out.sv
read_rtlil ../../../../../partitions/test1.por6_out.il
hierarchy -top miter; proc

async2sync
formalff -clk2ff -ff2anyinit gate.test1.por6_out
setundef -anyseq gate.test1.por6_out
flatten -wb; dffunmap; opt_expr -keepdc -undriven; opt_clean
xprop -formal -split-ports -assume-def-inputs miter

hierarchy -smtcheck
rename -witness
write_jny -no-connections ../model/design.json
write_rtlil ../model/design.il
