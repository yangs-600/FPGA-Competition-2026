# running in test3.gpioout/src/
verilog_defaults -add -D CHECK_OUTPUTS
read_verilog -sv ../../../../../partitions/test3.gpioout.sv
read_rtlil ../../../../../partitions/test3.gpioout.il
hierarchy -top miter; proc

async2sync
formalff -clk2ff -ff2anyinit gate.test3.gpioout
setundef -anyseq gate.test3.gpioout
flatten -wb; dffunmap; opt_expr -keepdc -undriven; opt_clean
xprop -formal -split-ports -assume-def-inputs miter

hierarchy -smtcheck
rename -witness
write_jny -no-connections ../model/design.json
write_rtlil ../model/design.il
